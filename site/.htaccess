# ========================================================
# Apache Configuration for cPanel / DirectAdmin
# ========================================================

# اولویت بارگذاری با index.php جهت تنظیم خودکار آدرس ساب‌دایرکتوری
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # هدایت مستقیم index.html به index.php
    RewriteRule ^index\.html$ index.php [L,QSA]

    # هدایت درخواست‌های تصویر Next.js
    RewriteRule ^_next/image/?$ _next/image.php [L,QSA]
    RewriteRule ^_next/image/(.*)$ _next/image.php [L,QSA]

    # محافظت از فایل‌های حساس
    <FilesMatch "^(config\.php|database\.sql|\.env|\.git)">
        <IfModule mod_authz_core.c>
            Require all denied
        </IfModule>
        <IfModule !mod_authz_core.c>
            Order deny,allow
            Deny from all
        </IfModule>
    </FilesMatch>
</IfModule>

# فعال‌سازی کش مرورگر
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
